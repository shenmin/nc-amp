// nc-amp extra resources:
//  - application manifest (per-monitor-v2 DPI awareness), RT_MANIFEST id 1
1         24     "nc-amp.manifest"
//  - audio engine ncaudio.dll (built from ../engine, open-source parts only),
//    extracted to %TEMP%\nc-amp_engine_<hash>\ on first start
NCAUDIO   RCDATA "engine/ncaudio.dll"
//  - LCD text font: IBM Plex Mono Medium, unmodified (SIL OFL 1.1),
//    loaded privately with AddFontMemResourceEx (not installed system-wide)
LCDFONT   RCDATA "../assets/fonts/IBMPlexMono-Medium.ttf"
